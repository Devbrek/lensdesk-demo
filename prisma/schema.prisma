generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())

  shootings Shooting[]
  inventory InventoryItem[] // relation inverse correctement définie
}

model Shooting {
  id          String    @id @default(cuid())
  title       String
  description String?
  location    String?
  date        DateTime?
  status      String
  createdAt   DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  checklist ChecklistItem[]
  notes     Note[]
}

model ChecklistItem {
  id      String  @id @default(cuid())
  label   String
  checked Boolean @default(false)
  type       String        @default("materiel") // "action" ou "materiel"
  priority         Int?           // facultatif, utilisé pour les actions

  shootingId String
  shooting   Shooting @relation(fields: [shootingId], references: [id])

  inventoryItemId String? // facultatif
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  createdAt DateTime @default(now())
}

model Note {
  id      String @id @default(cuid())
  content String

  shootingId String
  shooting   Shooting @relation(fields: [shootingId], references: [id])
}

model InventoryItem {
  id    String  @id @default(cuid())
  label String
  type  String? // optionnel : "appareil", "objectif", "accessoire"

  userId String
  user   User   @relation(fields: [userId], references: [id]) // relation inverse avec User

  createdAt      DateTime        @default(now())
  checklistItems ChecklistItem[]
}
