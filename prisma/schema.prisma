

generator client {
  provider = "prisma-client-js"
 
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name String
  password  String
  createdAt DateTime @default(now())
  shootings Shooting[]
}

model Shooting {
  id          String   @id @default(cuid())
  title       String
  description String?
  location    String?
  date        DateTime?
  status      String
  createdAt   DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id])

  checklist ChecklistItem[]
  notes     Note[]
}

model ChecklistItem {
  id         String   @id @default(cuid())
  label      String
  checked    Boolean  @default(false)

  shootingId String
  shooting   Shooting @relation(fields: [shootingId], references: [id])
}

model Note {
  id         String   @id @default(cuid())
  content    String

  shootingId String
  shooting   Shooting @relation(fields: [shootingId], references: [id])
}